# Backend API URL (Admin Panel uchun)
# Local:
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
# Production (Netlify env) — Render deploy dan keyin:
# VITE_API_URL=https://lider-navoiy-api.onrender.com/api/v1
# VITE_WS_URL=https://lider-navoiy-api.onrender.com

# Firebase Web (Admin panel push) — Firebase Console → Web app + Web Push certificates
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# (Ixtiyoriy) OSM.org dagi "Топографическая" qatlami — Tracestrack (bepul: 100k tile/oy)
# https://www.tracestrack.com/en/signup
# VITE_TRACESTRACK_KEY=your-tracestrack-key

# (Ixtiyoriy) OSM.org "Транспорт" va "Велосипедная" qatlamlari — Thunderforest
# https://www.thunderforest.com/
# VITE_THUNDERFOREST_KEY=your-thunderforest-key
