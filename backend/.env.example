# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=crm_user
DB_PASSWORD=crm_password
DB_DATABASE=distributor_crm

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Firebase (FCM) — https://console.firebase.google.com/
# Service Account kalitini: Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key ni bitta qator qilib, \n bilan yozing:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS (VPS production + local)
CORS_ORIGINS=https://lider-navoiy.uz,https://www.lider-navoiy.uz,http://lider-navoiy.uz,http://89.39.95.41,http://localhost:5173,http://localhost:3000

# Public base URL for uploaded files (chat images, etc.)
# Local: http://localhost:3000
# Production: https://lider-navoiy.uz
PUBLIC_URL=http://localhost:3000

# Cloud / Docker (ixtiyoriy — DATABASE_URL bo'lsa DB_HOST kerak emas)
# DATABASE_URL=postgresql://user:pass@host:5432/distributor_crm
# REDIS_URL=redis://host:6379
# TYPEORM_SYNC=true
# SEED_ON_BOOT=true
