<?xml version="1.0" encoding="utf-8"?>
<!--
  Qayta o'rnatishda eski sessiya (token) tiklanmasin — aks holda ilova
  yaroqsiz token bilan ochilib "sessiya tugadi" xabarini beradi.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
